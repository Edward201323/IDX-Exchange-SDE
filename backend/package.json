{
  "name": "idx-exchange-backend",
  "version": "1.0.0",
  "private": true,
  "description": "IDX internship REST API through week 4",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
